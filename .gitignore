############################################
# Datasets (ignore all except sample 0.0.1)
############################################
# Ignore all datasets
datasets/*

# But keep the sample 0.0.1 dataset (must un-ignore each parent level)
!datasets/sample/
datasets/sample/*
!datasets/sample/0.0.1/

# Keep the quick-start 0.0.1 dataset
!datasets/quick-start/
datasets/quick-start/*
!datasets/quick-start/0.0.1/

